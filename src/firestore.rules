rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents/meds/{id} {
      allow create, delete: if false;
    	allow read: if true;
      allow update: if request.auth != null && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["entries"]);
      allow update, create: if request.auth.uid == "orRtVC06dzWVHRByRjyJB3BfYnn2";
    
  }
  match /databases/{database}/documents/orders/{id} {
    	allow read: if true;
      allow update: if request.auth != null && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["meds", "status"]);
      allow create: if request.auth != null
      allow delete: if false;
    
  }
  match /databases/{database}/documents/aliases/{id} {
    	allow read: if true;
      allow update: if request.auth != null && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["entries"]);
      allow create, delete: if false;
    
  }
}